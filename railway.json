{
  "$schema": "https://railway.app/schema.json",
  "build": {
    "builder": "DOCKER",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "domains": [
    {
      "name": "lingui-news.up.railway.app",
      "type": "DEFAULT"
    }
  ],
  "environmentVariables": {
    "NODE_ENV": "production",
    "PYTHONUNBUFFERED": "1"
  },
  "region": "us-east"
}

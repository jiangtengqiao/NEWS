# 数据库 - 先用 SQLite，简单方便
DATABASE_URL=sqlite:///./customize_news.db

# JWT 密钥（生产环境要改复杂的）
SECRET_KEY=my-super-secret-key-for-development
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 邮件服务（暂时不用）
EMAIL_BACKEND=console
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=Customize-News

# 阿里云 OSS（暂时不用）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=oss-cn-guilin.aliyuncs.com
OSS_REGION=cn-guilin
